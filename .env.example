# Microsoft (Outlook / Excel) 連携設定
# Azure Portal > Microsoft Entra ID > アプリの登録 で取得
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 送信元となる Outlook / Microsoft 365 メールボックス
MS_SENDER_EMAIL=t.sakon@sakon-transport.com
# お問い合わせの送信先（未設定時は会社メールアドレス）
CONTACT_TO_EMAIL=t.sakon@sakon-transport.com

# Excel 連携（任意）: お問い合わせを OneDrive 上の Excel テーブルに記録
# Excel を保存している OneDrive の所有者（未設定時は MS_SENDER_EMAIL）
MS_EXCEL_OWNER_EMAIL=
# OneDrive ルートからのパス
MS_EXCEL_FILE_PATH=お問い合わせ/お問い合わせ一覧.xlsx
# テーブル名（列: 受付日時, お名前, 会社名, メールアドレス, 電話番号, お問い合わせ内容）
MS_EXCEL_TABLE_NAME=Inquiries
